# OnlineFirPortal backend environment configuration.
#
# Copy this file to .env and fill in real values. The server loads it with
# dotenv-safe (src/lib/env.ts), which fails fast on startup if any variable
# listed here is missing or empty in .env. Variables that have code defaults
# are documented below; the required secrets MUST be set to unique values.

# --- Runtime ---
# Node environment. Use "development" locally, "production" in Docker.
NODE_ENV="development"

# HTTP port the Express server listens on (default 4001).
PORT=4001

# Allowed browser origin for CORS. Must match the frontend URL.
CORS_ORIGIN="http://localhost:4000"

# --- Database ---
# Prisma connection URL. Local development uses the SQLite file below.
# Docker Compose overrides this with a Postgres URL.
DATABASE_URL="file:./dev.db"

# Optional absolute path override for the SQLite database file. Used by
# tests to isolate the database (see src/lib/database-connection.ts and
# src/lib/prisma.ts). Leave unset for normal development.
# DATABASE_PATH=""

# --- Required secrets (unique per deployment; never commit real values) ---
# JWT signing secret for short-lived access tokens.
JWT_SECRET="replace-with-a-strong-random-secret"

# JWT signing secret for long-lived refresh tokens. Use a different value
# than JWT_SECRET.
JWT_REFRESH_SECRET="replace-with-a-strong-random-refresh-secret"

# AES-256-GCM key used to encrypt sensitive fields. A 32-byte random value
# (see src/lib/security.ts and src/scripts/generate-keys.ts).
ENCRYPTION_KEY="replace-with-a-strong-32-byte-encryption-key"

# AES-256-GCM key used specifically for FIR payload encryption. Must differ
# from ENCRYPTION_KEY.
FIR_ENCRYPTION_KEY="replace-with-a-strong-32-byte-fir-encryption-key"

# --- Rate limiting (optional; code defaults shown) ---
# General API rate limit window in milliseconds (default 15 minutes).
API_RATE_LIMIT_WINDOW_MS=900000
# General API rate limit: max requests per window (default 500).
API_RATE_LIMIT_MAX=500
# Authentication endpoints rate limit window in milliseconds (default 1 hour).
AUTH_RATE_LIMIT_WINDOW_MS=3600000
# Authentication endpoints rate limit: max requests per window (default 300).
AUTH_RATE_LIMIT_MAX=300
# Custom (security-lab) rate limit window in milliseconds (default 15 minutes).
CUSTOM_RATE_LIMIT_WINDOW_MS=900000
# Custom (security-lab) rate limit: max requests per window (default 300).
CUSTOM_RATE_LIMIT_MAX=300
