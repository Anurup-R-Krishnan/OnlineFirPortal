# OnlineFirPortal frontend environment configuration.
#
# Copy this file to .env.local for local development. Next.js loads .env.local
# automatically. Never commit real values.

# --- Runtime ---
# Node environment (Next.js sets this; use "development" locally).
NODE_ENV="development"

# Port the Next.js dev server listens on (default 4000; set in package.json
# via "next dev -p 4000"). Uncomment only to override.
# PORT=4000

# --- Backend proxy target ---
# Base URL of the backend API. next.config.mjs rewrites every /api/* request
# to this base (read as NEXT_PUBLIC_API_BASE_URL || API_BASE_URL, falling back
# to http://localhost:5000). The backend default port is 4001, so set this for
# local development:
API_BASE_URL="http://localhost:4001"

# Optional public variant of the above. If you need the API base available in
# the browser bundle (NEXT_PUBLIC_ prefix), set it here instead. The server-side
# rewrite uses API_BASE_URL when present.
# NEXT_PUBLIC_API_BASE_URL="http://localhost:4001"
